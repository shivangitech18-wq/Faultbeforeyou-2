# Gemma 4 API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_api_key_here

# Model Selection: Documented initial choice is gemma-4-26b-a4b-it
# Other supported Gemma models: gemma-2-27b-it, gemma-2-9b-it
GEMMA_MODEL=gemma-4-26b-a4b-it

# Server Configuration
PORT=3000
FRONTEND_ORIGIN=http://localhost:5500

# Security
JWT_SECRET=super-secret-hackathon-key-faultbeforeyou-2026
